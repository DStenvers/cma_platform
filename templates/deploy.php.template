<?php
/**
 * deploy.php — the ONE and ONLY GitHub deploy webhook (recovery hatch).
 *
 * THIS FILE IS PROVISIONED BY stenversonline/platform (Installer.php) and is
 * overwritten on every `composer update stenversonline/platform`. Edit the
 * source at templates/deploy.php.template in the platform repo — local edits
 * here are lost. Commit it to your consumer repo so a plain `git pull` keeps
 * it alive even when composer hasn't run.
 *
 * WHY A ROOT FILE: it sits at the site ROOT, is git-tracked, and depends on
 * NOTHING inside vendor/, /cma/, or IIS URL Rewrite — so a botched composer
 * install (which would 404 anything under /cma/) can't take it down. The next
 * push always lands here and repairs whatever broke. As of v1.21.x this is the
 * single deploy endpoint; the framework (cma/tools/deploy_webhook.php +
 * DeployWebhook) and standalone (cma/tools/deploy_webhook_standalone.php)
 * variants were retired and folded in here.
 *
 *   Payload URL : https://<host>/deploy.php
 *   Content type: application/json
 *   Secret      : DEPLOY_SECRET (see below)
 *   Events      : just the push event
 *
 * .env configuration (inline-parsed — no phpdotenv dependency. Prefers a
 * single .env (the standard one-file-per-box model the platform Bootstrap
 * now uses too), then falls back to the legacy .env.production / .env.local /
 * … files. So DEPLOY_SECRET lives in the SAME .env the app reads — no more
 * "which env file holds the secret?" guesswork):
 *   DEPLOY_SECRET            required; HMAC secret matching the GitHub webhook.
 *   DEPLOY_BRANCH            branch to deploy (default: main).
 *   DEPLOY_SITE_ROOT         git working tree (default: this file's directory).
 *   DEPLOY_PIPELINE          ;-separated commands; {branch} is substituted.
 *                            Default: git pull --ff-only origin {branch}
 *   DEPLOY_NO_RESET          1 = skip the pre-pull `git checkout -- .`.
 *   DEPLOY_NO_PRE_PULL_TOUCH 1 = skip the pre-pull recycle (Windows file-lock
 *                            release before git/composer run).
 *   DEPLOY_COMPOSER_UPDATE   comma-separated packages to `composer update`
 *                            after the pipeline. Default: stenversonline/platform.
 *                            "-" skips the composer step entirely.
 *   DEPLOY_COMPOSER_CLEAR_CACHE 1 = run `composer clear-cache` BEFORE the update,
 *                            so a freshly-pushed platform tag isn't missed because
 *                            Composer's VCS clone cache pinned an old ref ("Nothing
 *                            to modify"). Off by default (re-clone is slower). For a
 *                            one-off without touching .env, append ?forcerefresh=Y to
 *                            the deploy URL (e.g. the GitHub webhook Payload URL).
 *   DEPLOY_RUN_TESTS         command run AFTER pull/composer, BEFORE recycle.
 *                            Non-zero exit => deploy FAILED, recycle + post-hook
 *                            skipped (production stays on the old code).
 *                            Default: "" (no gate). e.g. php cma/tests/TestRunner.php
 *   DEPLOY_RECYCLE_TOUCH     file to touch on success (IIS app-pool recycle).
 *                            Default: <root>/web.config. "-" to skip.
 *   DEPLOY_POST_HOOK         PHP file required after a successful deploy.
 *                            Default: <root>/deploy_post.php. "-" to skip.
 *   DEPLOY_LOG_FILE          log path. Default: <root>/logs/deploy.log.
 *   DEPLOY_ALERT_EMAIL       if set, a FAILED deploy also tries mail() to this
 *                            address (best-effort; no MTA required to succeed).
 *
 * SCREAM LOUD on failure — every reliable, dependency-free channel fires:
 *   1. a FAILED footer banner in the log (surfaced remotely by deploy_status.php),
 *   2. a PHP error_log() line (php_errors.log / diag.php),
 *   3. a <log_dir>/deploy.failed marker file (cleared on the next green deploy),
 *   4. best-effort mail() to DEPLOY_ALERT_EMAIL when set.
 */

declare(strict_types=1);

$SCRIPT_DIR = __DIR__;
$isWin = (stripos(PHP_OS, 'WIN') === 0);

// ---------------------------------------------------------------------------
// 1. Inline .env reader — first-existing env file, KEY=VALUE lines.
// ---------------------------------------------------------------------------
$env = [];
$envLoadedFrom = '';
foreach (['.env', '.env.production', '.env.acceptance', '.env.test', '.env.local'] as $cand) {
    $p = $SCRIPT_DIR . '/' . $cand;
    if (!is_file($p)) {
        continue;
    }
    foreach ((array)file($p, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        $line = trim($line);
        if ($line === '' || $line[0] === '#' || strpos($line, '=') === false) {
            continue;
        }
        [$k, $v] = explode('=', $line, 2);
        $env[trim($k)] = trim($v, " \t\"'");
    }
    $envLoadedFrom = $p;
    break;
}
$envRead = static function (string $key, string $default = '') use ($env): string {
    $v = $env[$key] ?? getenv($key);
    return ($v === false || $v === null || $v === '') ? $default : (string)$v;
};

$ROOT     = rtrim($envRead('DEPLOY_SITE_ROOT', $SCRIPT_DIR), '/\\');
$LOG_FILE = $envRead('DEPLOY_LOG_FILE', $ROOT . '/logs/deploy.log');
$LOG_DIR  = dirname($LOG_FILE);
if (!is_dir($LOG_DIR)) {
    @mkdir($LOG_DIR, 0755, true);
}

// Redact credentials a DEPLOY_PIPELINE (or git/composer output) might echo —
// e.g. a PAT baked into a `git remote set-url https://user:TOKEN@host` step — so
// neither the on-disk log NOR the public deploy_status.php tail can leak it. The
// twin of this lives in deploy_status.php for already-written logs.
$redact = static function (string $s): string {
    $out = preg_replace(
        [
            '#(://[^/@:\s]+:)[^/@\s]+@#',      // user:password@host  (PAT in a git URL)
            '#github_pat_[A-Za-z0-9_]+#',      // fine-grained PAT
            '#gh[posru]_[A-Za-z0-9]{20,}#',    // classic PAT / OAuth / server / refresh / user-to-server
        ],
        ['$1***@', 'github_pat_***', 'gh*_***'],
        $s
    );
    return $out ?? $s;
};

$log = static function (string $msg) use ($LOG_FILE, $redact): void {
    @file_put_contents($LOG_FILE, '[' . date('Y-m-d H:i:s') . '] ' . $redact($msg) . "\n", FILE_APPEND);
};
$logRaw = static function (string $text) use ($LOG_FILE, $redact): void {
    @file_put_contents($LOG_FILE, $redact($text), FILE_APPEND);
};

// Loud-failure reporter — reliable, dependency-free channels + best-effort mail.
$FAIL_MARKER = $LOG_DIR . '/deploy.failed';
$scream = static function (string $reason) use ($log, $FAIL_MARKER, $envRead): void {
    @error_log('DEPLOY FAILED: ' . str_replace("\n", ' | ', $reason));
    @file_put_contents($FAIL_MARKER, '[' . date('Y-m-d H:i:s') . '] ' . $reason . "\n");
    $to = $envRead('DEPLOY_ALERT_EMAIL', '');
    if ($to !== '') {
        $host = (string)($_SERVER['HTTP_HOST'] ?? (function_exists('gethostname') ? gethostname() : '?'));
        @mail($to, '[deploy] FAILED on ' . $host, $reason);
    }
    $log('SCREAM: failure reported via error_log + ' . basename($FAIL_MARKER) . ($to !== '' ? ' + mail' : ''));
};

$secret = $envRead('DEPLOY_SECRET', '');
$branch = $envRead('DEPLOY_BRANCH', 'main');

// On-demand cache-bust via query string (?forcerefresh=Y) — clears Composer's
// VCS clone cache for THIS deploy without editing any server file: add it to the
// GitHub webhook Payload URL, or to a manual trigger. Read case-insensitively.
// Only takes effect at the composer step (4d), which runs AFTER the HMAC + branch
// gate below — so it grants no access, it just toggles the cache clear.
$forceRefresh = false;
foreach ($_GET as $gk => $gv) {
    if (strcasecmp((string)$gk, 'forcerefresh') === 0 && !is_array($gv)) {
        $forceRefresh = in_array(strtolower((string)$gv), ['y', '1', 'true', 'yes'], true);
        break;
    }
}

// Log which .env was actually read (first-existing of the candidates next to
// this file) so a missing DEPLOY_SECRET is easy to diagnose.
$log('config: env-file=' . ($envLoadedFrom !== '' ? $envLoadedFrom : 'NONE found in ' . $SCRIPT_DIR)
    . ', DEPLOY_SECRET=' . ($secret !== '' ? 'present' : 'absent'));

// ---------------------------------------------------------------------------
// 2. Gatekeeping: secret configured, POST only, valid HMAC, right branch.
// ---------------------------------------------------------------------------
if ($secret === '') {
    http_response_code(503);
    header('Content-Type: text/plain; charset=utf-8');
    $where = $envLoadedFrom !== ''
        ? $envLoadedFrom
        : 'no .env file next to ' . $SCRIPT_DIR;
    $log('REJECT: DEPLOY_SECRET not configured (looked in ' . $where . ')');
    echo "Deploy not configured — DEPLOY_SECRET missing "
       . ($envLoadedFrom !== ''
            ? 'in ' . $envLoadedFrom
            : '(no .env file found next to ' . $SCRIPT_DIR
              . '; checked .env, .env.production, .env.acceptance, .env.test, .env.local)')
       . ".\n";
    return;
}
if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') {
    http_response_code(405);
    header('Content-Type: text/plain; charset=utf-8');
    echo "POST only.\n";
    return;
}
$payload   = (string)file_get_contents('php://input');
$signature = (string)($_SERVER['HTTP_X_HUB_SIGNATURE_256'] ?? '');
$expected  = 'sha256=' . hash_hmac('sha256', $payload, $secret);
if (!hash_equals($expected, $signature)) {
    http_response_code(403);
    header('Content-Type: text/plain; charset=utf-8');
    $log('REJECT: signature mismatch from ' . ($_SERVER['REMOTE_ADDR'] ?? '?'));
    echo "Bad signature.\n";
    return;
}
$body   = json_decode($payload, true);
$ref    = is_array($body) ? (string)($body['ref'] ?? '') : '';
$commit = is_array($body) ? substr((string)($body['after'] ?? 'unknown'), 0, 12) : 'unknown';
$pusher = is_array($body) ? (string)($body['pusher']['name'] ?? ($body['sender']['login'] ?? '?')) : '?';
if ($ref !== "refs/heads/$branch") {
    http_response_code(202);
    header('Content-Type: text/plain; charset=utf-8');
    $log("SKIP: $ref != refs/heads/$branch");
    echo "Skipped: $ref != refs/heads/$branch\n";
    return;
}

// ---------------------------------------------------------------------------
// 3. Reply 202 immediately, then run async (GitHub times out long before
//    composer/tests finish).
// ---------------------------------------------------------------------------
http_response_code(202);
header('Content-Type: text/plain; charset=utf-8');
echo "Deploy started: $commit\n";
if (function_exists('fastcgi_finish_request')) {
    @fastcgi_finish_request();
} else {
    while (ob_get_level() > 0) {
        @ob_end_flush();
    }
    @flush();
}
ignore_user_abort(true);
@set_time_limit(600);

$bannerLine = str_repeat('-', 60) . "\n";
$logRaw("\n" . $bannerLine
    . 'deploy started: ' . date('Y-m-d H:i:s') . ' ' . $branch
    . " (commit $commit by $pusher)\n" . $bannerLine);

// ---------------------------------------------------------------------------
// 4. Command runner. Each command runs in $ROOT; no chdir() side effects.
// ---------------------------------------------------------------------------
$run = static function (string $cmd) use ($ROOT, $isWin, $log): int {
    $log("RUN: $cmd");
    $output = [];
    $exit   = 0;
    if ($isWin) {
        @exec('cmd /c "cd /d "' . $ROOT . '" && ' . $cmd . ' 2>&1"', $output, $exit);
    } else {
        @exec('cd ' . escapeshellarg($ROOT) . ' && ' . $cmd . ' 2>&1', $output, $exit);
    }
    $log("EXIT: $exit\n--- output ---\n" . implode("\n", $output) . "\n--- end ---");
    return $exit;
};

$failed     = false;
$failReason = '';

// 4a. Pre-pull recycle — release Windows file locks on bootstrap/vendor before
//     git/composer touch them. Windows-only, opt-out, best-effort.
$recycleFile = $envRead('DEPLOY_RECYCLE_TOUCH', $ROOT . '/web.config');
if ($isWin
    && $envRead('DEPLOY_NO_PRE_PULL_TOUCH', '') !== '1'
    && $recycleFile !== '-' && $recycleFile !== '' && is_file($recycleFile)) {
    @touch($recycleFile);
    $log('RECYCLE (pre-pull): touched ' . $recycleFile);
}

// 4b. Optional pre-pull reset so composer.lock churn can't block an ff-only pull.
if ($envRead('DEPLOY_NO_RESET', '') !== '1') {
    $run('git checkout -- .');
}

// 4c. Pipeline ( ;-separated; {branch} substituted ). Aborts on first failure.
$pipeline = $envRead('DEPLOY_PIPELINE', 'git pull --ff-only origin {branch}');
foreach (array_filter(array_map('trim', explode(';', $pipeline))) as $step) {
    $cmd = str_replace('{branch}', $branch, $step);
    if ($run($cmd) !== 0) {
        $failed     = true;
        $failReason = "pipeline step failed: $cmd";
        break;
    }
}

// 4d. Composer update (pull the latest platform + deps). Resolve a usable
//     composer binary first — the app-pool identity rarely has it on PATH.
$composerPkgs = $envRead('DEPLOY_COMPOSER_UPDATE', 'stenversonline/platform');
if (!$failed && $composerPkgs !== '-' && $composerPkgs !== '') {
    $composer = null;
    foreach ([
        'composer',
        '"C:\ProgramData\ComposerSetup\bin\composer.bat"',
        '"C:\composer\composer.bat"',
        'php "' . $ROOT . '\composer.phar"',
    ] as $candidate) {
        $probe = [];
        $pexit = 0;
        if ($isWin) {
            @exec('cmd /c "' . $candidate . ' --version" 2>&1', $probe, $pexit);
        } else {
            @exec($candidate . ' --version 2>&1', $probe, $pexit);
        }
        if ($pexit === 0) {
            $composer = $candidate;
            break;
        }
    }
    if ($composer === null) {
        $failed     = true;
        $failReason = 'composer binary not found (PATH / ComposerSetup / C:\composer\ / composer.phar)';
        $log('FAIL: ' . $failReason);
    } else {
        $log("composer = $composer");
        // Optional: clear Composer's caches (incl. the VCS clone cache) BEFORE the
        // update. Composer keeps a per-repo clone cache; a freshly-pushed tag can be
        // missed ("Nothing to modify" / an old ref resolved) until that cache is
        // dropped. Triggered per-deploy by ?forcerefresh=Y on the URL (no server-file
        // edit needed), or permanently by DEPLOY_COMPOSER_CLEAR_CACHE=1. Off by
        // default — clearing forces a re-clone and slows the next resolve, so enable
        // it only when a deploy must pull a brand-new platform release.
        // Best-effort: a failing clear-cache does NOT abort the deploy.
        if ($forceRefresh || $envRead('DEPLOY_COMPOSER_CLEAR_CACHE', '') === '1') {
            $log('composer clear-cache (' . ($forceRefresh ? '?forcerefresh=Y' : 'DEPLOY_COMPOSER_CLEAR_CACHE=1') . ')');
            $run($composer . ' clear-cache --no-interaction');
        }
        $pkgArgs = implode(' ', array_map(
            'escapeshellarg',
            preg_split('/\s*,\s*/', $composerPkgs, -1, PREG_SPLIT_NO_EMPTY) ?: []
        ));
        if ($run($composer . ' update ' . $pkgArgs . ' --no-dev --optimize-autoloader --no-interaction') !== 0) {
            // `composer update` failed — most often the private platform repo
            // is briefly unreachable / unauthenticated (missing token, SSH
            // fallback, unwritable composer home), NOT a broken tree. Fall back
            // to `composer install`, which restores a consistent vendor/ from
            // the existing lock (keeps the locked platform version, no network
            // fetch of the new one) so the rest of the deploy still runs —
            // migrations, asset build and cache flush in deploy_post. Only a
            // failing install (genuinely broken vendor) aborts the deploy.
            $log('WARN: composer update failed — falling back to composer install (keeps the locked platform version, lets deploy_post run)');
            if ($run($composer . ' install --no-dev --optimize-autoloader --no-interaction') !== 0) {
                $failed     = true;
                $failReason = 'composer update AND install both failed';
            }
        }
    }
}

// 4e. Test gate — run AFTER pull/composer, BEFORE recycle. Non-zero exit means
//     the new code is broken; do NOT recycle so production keeps the old code.
$runTests = $envRead('DEPLOY_RUN_TESTS', '');
if (!$failed && $runTests !== '' && $runTests !== '-') {
    if ($run($runTests) !== 0) {
        $failed     = true;
        $failReason = "test gate failed: $runTests";
        $log('FAIL: tests failed — skipping recycle + post-hook (production stays on old code)');
    }
}

// 4f. Recycle on success.
if (!$failed && $recycleFile !== '-' && $recycleFile !== '' && is_file($recycleFile)) {
    @touch($recycleFile);
    $log('RECYCLE: touched ' . $recycleFile);
}

// 4g. /cma/ sync health-check + project post-hook — best-effort, success-only,
//     and only when the app autoloader is present (keeps the hatch self-sufficient).
if (!$failed) {
    $autoload = $ROOT . '/vendor/autoload.php';
    if (is_file($autoload)) {
        @require_once $autoload;
    }

    if (class_exists(\App\Library\DeployHealth::class)) {
        try {
            \App\Library\DeployHealth::cmaSyncCheck($ROOT, ['log_file' => $LOG_FILE]);
        } catch (\Throwable $e) {
            $log('WARN: DeployHealth threw ' . $e->getMessage());
        }
    }

    $postHook = $envRead('DEPLOY_POST_HOOK', $ROOT . '/deploy_post.php');
    if ($postHook !== '-' && $postHook !== '' && is_file($postHook)) {
        $log('RUN: ' . basename($postHook));
        try {
            require $postHook;
            $log('OK: ' . basename($postHook));
        } catch (\Throwable $e) {
            $log('WARN: post-hook threw ' . get_class($e) . ': ' . $e->getMessage());
        }
    }
}

// ---------------------------------------------------------------------------
// 5. Status + footer banner + scream-loud on failure.
// ---------------------------------------------------------------------------
$status = $failed ? 'FAILED' : 'OK';
$log("$status: deploy $commit");
$logRaw($bannerLine
    . 'deploy ended:   ' . date('Y-m-d H:i:s') . ' ' . $branch
    . " (commit $commit, $status)\n" . $bannerLine . "\n");

if ($failed) {
    $scream("deploy $commit on $branch FAILED — $failReason. See $LOG_FILE.");
} else {
    @unlink($FAIL_MARKER); // clear any stale failure flag on a green deploy
}
