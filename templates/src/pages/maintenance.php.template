<?php
/**
 * Maintenance page — included by _bootstrap.php's maintenance gate while a
 * maintenance.flag is present (set by the CMA maintenance tool or deploy.php).
 *
 * The gate has already sent the 503 status + Content-Type headers and sets
 * exactly ONE variable before including this file:
 *
 *   $message — the text the admin typed in the CMA maintenance tool.
 *              Empty during a deploy or when no custom text was given; a
 *              sensible default is used then.
 *
 * MUST stay dependency-free: no Composer autoload, no App\Library\* — this runs
 * before the autoloader and possibly mid-deploy. Native PHP only, and it must
 * never itself fatal.
 */

$message = (isset($message) && is_string($message) && trim($message) !== '')
    ? trim($message)
    : 'We zijn even bezig met de website, duurt niet lang.';

$h = static fn($s): string => htmlspecialchars((string) $s, ENT_QUOTES, 'UTF-8');
?>
