<?php
/**
 * Maintenance page — included by _bootstrap.php's maintenance gate while a
 * maintenance.flag is present (set by the CMA maintenance tool or deploy.php).
 *
 * The gate sets exactly ONE variable before including this file:
 *
 *   $message — the text the admin typed in the CMA maintenance tool.
 *              Empty during a deploy or when no custom text was given.
 *
 * The page itself lives in the platform (cma/maintenance_page.inc), so layout
 * improvements arrive with a composer update instead of needing an edit per
 * site. It reads its branding from data/maintenance.json, then data/app.json's
 * "maintenance" block, then the "company" block of data/cma_branding.json —
 * logo, name, message, accent, whatsapp, email — and shows the illustration at
 * assets/images/maintenance.svg when the site ships one.
 *
 * The inline fallback below runs when cma/ is not there (a fresh checkout, or a
 * deploy that has not synced yet). Keep BOTH paths dependency-free: no Composer
 * autoload, no App\Library\* — this runs before the autoloader and must never
 * itself fatal.
 */

$cmaMaintPage = __DIR__ . '/../../cma/maintenance_page.inc';
if (is_file($cmaMaintPage)) {
    include $cmaMaintPage;
    return;
}

$message = (isset($message) && is_string($message) && trim($message) !== '')
    ? trim($message)
    : 'We zijn even bezig met de website, duurt niet lang.';

$h = static fn($s): string => htmlspecialchars((string) $s, ENT_QUOTES, 'UTF-8');
?>
<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Even geduld</title>
<style>
  :root { color-scheme: light; }
  html { height: 100%; }
  body {
    margin: 0; min-height: 100%;
    display: flex; align-items: center; justify-content: center; padding: 1.5rem;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    background: #faf8f5; color: #2b2622;
  }
  .box { max-width: 30rem; text-align: center; }
  h1 { font-size: 1.55rem; font-weight: 600; margin: 0 0 .6rem; line-height: 1.3; }
  p { margin: .5rem 0; line-height: 1.6; color: #5c5449; }
</style>
</head>
<body>
  <div class="box">
    <h1><?= $h($message) ?></h1>
    <p>Probeer het over een paar minuten opnieuw.</p>
  </div>
</body>
</html>
