<?php
/**
 * deploy_status.php — read-only JSON summary of the last deploy run,
 * read from <site-root>/logs/deploy.log.
 *
 * THIS FILE IS PROVISIONED BY stenversonline/platform (Installer.php) and
 * overwritten on every `composer update stenversonline/platform` — edit
 * templates/deploy_status.php.template in the platform repo. Commit it to
 * your consumer repo so a plain `git pull` keeps it alive.
 *
 * It is the SITE-ROOT twin of cma/tools/deploy_status.php, which lives
 * inside the gitignored, composer-synced /cma/ tree — exactly what goes
 * 404 during a botched deploy, taking that status endpoint down right when
 * you need it. This file is git-tracked at the root and depends on nothing
 * but standard PHP, so `curl https://<host>/deploy_status.php | jq` answers
 * even when /cma/, vendor/, and URL Rewrite are all broken. Pairs with the
 * root recovery-hatch deploy.php.
 *
 * Auth: NONE. status + commit-SHA + branch + timestamp aren't sensitive
 * (commit-SHAs + branch names are public git history; deploy-state is
 * observable by hitting the site). log_tail is pipeline output (git pull /
 * composer); credentials a pipeline might echo (e.g. a PAT in a
 * `git remote set-url https://user:TOKEN@host` step) are stripped by $redact
 * below before it is served — deploy.php also redacts at write time.
 *
 * Parses BOTH on-disk log formats, whichever wrote last:
 *   1. Banners (current /deploy.php and the retired DeployWebhook) ..
 *                               "deploy started: <ts> <b> (commit <c> ...)"
 *                               "deploy ended:   <ts> <b> (commit <c>, OK|FAILED)"
 *   2. Legacy "[self]" lines from the pre-v1.22 root deploy.php ..
 *                               "[ts] [self] START: deploy <c> on branch <b>"
 *                               "[ts] [self] OK|FAIL: deploy <c>"
 *      (kept so older deploy.log tails still parse)
 *
 * `ok` reflects deploy HEALTH: true only when the last deploy ended OK (or is
 * still RUNNING). A FAILED deploy returns {"ok": false, "status": "FAILED", ...}
 * with NO `error` field. Transport problems also return ok=false but DO carry an
 * `error` field — so: error present = endpoint problem; status=FAILED = the
 * deploy itself failed.
 *
 * Failure modes:
 *   404  — {"ok": false, "error": "deploy.log not found"}
 *   500  — {"ok": false, "error": "log file unreadable"}
 *   200  — {"ok": false, "error": "no completed deploy in log"}
 *   200  — {"ok": false, "status": "FAILED", ...}  (last deploy failed)
 */

header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-store');

// Redact credentials from anything we echo. The log SHOULD already be clean
// (deploy.php redacts at write time), but logs written before that fix — or a
// pipeline that prints a token some other way — must never leak through here.
// Twin of the $redact closure in deploy.php.
$redact = static function (string $s): string {
    $out = preg_replace(
        [
            '#(://[^/@:\s]+:)[^/@\s]+@#',      // user:password@host  (PAT in a git URL)
            '#github_pat_[A-Za-z0-9_]+#',      // fine-grained PAT
            '#gh[posru]_[A-Za-z0-9]{20,}#',    // classic PAT / OAuth / server / refresh / user-to-server
        ],
        ['$1***@', 'github_pat_***', 'gh*_***'],
        $s
    );
    return $out ?? $s;
};

// ---------------------------------------------------------------------------
// Config self-check mode: GET ?config=1
// Read-only diagnostics of the deploy configuration — reports WHAT is missing,
// never the values (DEPLOY_SECRET is yes/no only) and never writes anything.
// Use the developer-only "Deploy setup" CMA tool to actually fill gaps in.
// Gated behind the query param so normal status polls stay lean (no exec).
// ---------------------------------------------------------------------------
if (isset($_GET['config'])) {
    $isWin = (stripos(PHP_OS, 'WIN') === 0);

    // First-existing env file next to this script — .env-first, same
    // precedence as deploy.php and the platform bootstrap (single-.env model).
    $env = [];
    $envFile = null;
    foreach (['.env', '.env.production', '.env.acceptance', '.env.test', '.env.local'] as $cand) {
        $p = __DIR__ . '/' . $cand;
        if (!is_file($p)) {
            continue;
        }
        foreach ((array)file($p, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
            $line = trim($line);
            if ($line === '' || $line[0] === '#' || strpos($line, '=') === false) {
                continue;
            }
            [$k, $v] = explode('=', $line, 2);
            $env[trim($k)] = trim($v, " \t\"'");
        }
        $envFile = $cand;
        break;
    }
    $envGet = static function (string $key) use ($env) {
        $v = $env[$key] ?? getenv($key);
        return ($v === false || $v === null) ? '' : (string)$v;
    };

    // Probe a binary with a fixed (no user input) --version call.
    $probe = static function (string $bin) use ($isWin): bool {
        $out = [];
        $exit = 0;
        if ($isWin) {
            @exec('cmd /c "' . $bin . ' --version" 2>&1', $out, $exit);
        } else {
            @exec($bin . ' --version 2>&1', $out, $exit);
        }
        return $exit === 0;
    };
    $composerOk = $probe('composer')
        || $probe('"C:\ProgramData\ComposerSetup\bin\composer.bat"')
        || (is_file(__DIR__ . '/composer.phar') && $probe('php "' . __DIR__ . '\composer.phar"'));

    $logDir       = __DIR__ . '/logs';
    $logsWritable = is_dir($logDir) ? is_writable($logDir) : is_writable(__DIR__);

    $cfg = [
        'env_file'      => $envFile,                       // which .env was read (null = none)
        'deploy_secret' => $envGet('DEPLOY_SECRET') !== '', // presence only, never the value
        'deploy_branch' => $envGet('DEPLOY_BRANCH') !== '' ? $envGet('DEPLOY_BRANCH') : 'main',
        'alert_email'   => $envGet('DEPLOY_ALERT_EMAIL') !== '',
        'logs_writable' => $logsWritable,
        'git'           => $probe('git'),
        'composer'      => $composerOk,
    ];

    // Required-for-a-working-deploy items that are currently missing.
    $missing = [];
    if ($envFile === null)            { $missing[] = 'env_file'; }
    if (!$cfg['deploy_secret'])       { $missing[] = 'DEPLOY_SECRET'; }
    if (!$cfg['logs_writable'])       { $missing[] = 'logs_writable'; }
    if (!$cfg['git'])                 { $missing[] = 'git'; }
    $cfg['missing'] = $missing;
    $cfg['ok']      = empty($missing);

    echo json_encode(['ok' => true, 'config' => $cfg]);
    return;
}

$logFile = __DIR__ . '/logs/deploy.log';

if (!is_file($logFile)) {
    http_response_code(404);
    echo json_encode(['ok' => false, 'error' => 'deploy.log not found', 'path' => $logFile]);
    return;
}

// Read last ~16KB — plenty for one deploy run + a useful tail.
$size      = filesize($logFile) ?: 0;
$chunkSize = (int)min($size, 16 * 1024);
$tail      = '';
if ($chunkSize > 0) {
    // @ on fopen prevents a PHP warning from leaking into the JSON response,
    // but we MUST distinguish "fopen failed" (permissions / lock) from "log
    // has no banner". Masking the former as an empty-log status sends the
    // operator the wrong way — the pre-v1.19.6 bug.
    $fh = @fopen($logFile, 'rb');
    if (!$fh) {
        http_response_code(500);
        echo json_encode(['ok' => false, 'error' => 'log file unreadable', 'path' => $logFile]);
        return;
    }
    @fseek($fh, -$chunkSize, SEEK_END);
    $tail = (string)stream_get_contents($fh);
    @fclose($fh);
}
$lines = preg_split('/\r?\n/', $tail) ?: [];

// Walk backwards collecting the most recent end + start markers, accepting
// either log dialect. Normalise FAIL → FAILED so the output status word is
// the same regardless of which webhook produced the line.
$endedAt = null; $endedStatus = null; $endedBranch = null; $endedCommit = null;
$startedAt = null; $startedBranch = null; $startedCommit = null;

foreach (array_reverse($lines) as $line) {
    // --- end markers ---
    if ($endedAt === null
        && preg_match('/^\[([\d-]+ [\d:]+)\] \[self\] (OK|FAIL): deploy (\S+)/', $line, $m)) {
        $endedAt     = $m[1];
        $endedStatus = $m[2] === 'OK' ? 'OK' : 'FAILED';
        $endedCommit = $m[3];
        continue;
    }
    if ($endedAt === null
        && preg_match('/^deploy ended:\s+(\S+ \S+)\s+(\S+)\s+\(commit\s+(\S+),\s+(OK|FAILED)\)/', $line, $m)) {
        $endedAt     = $m[1];
        $endedBranch = $m[2];
        $endedCommit = $m[3];
        $endedStatus = $m[4];
        continue;
    }

    // --- start markers ---
    if (preg_match('/^\[([\d-]+ [\d:]+)\] \[self\] START: deploy (\S+) on branch (\S+)/', $line, $m)) {
        $startedAt     = $m[1];
        $startedCommit = $m[2];
        $startedBranch = $m[3];
        if ($endedAt === null || $startedCommit !== $endedCommit) { break; }
        continue;
    }
    if (preg_match('/^deploy started:\s+(\S+ \S+)\s+(\S+)\s+\(commit\s+(\S+)/', $line, $m)) {
        $startedAt     = $m[1];
        $startedBranch = $m[2];
        $startedCommit = $m[3];
        if ($endedAt === null || $startedCommit !== $endedCommit) { break; }
        continue;
    }
}

$result = ['ok' => true, 'log_tail' => $redact(implode("\n", array_slice($lines, -40)))];
$now = time();

// In-progress: a start newer than the latest end (or no end at all).
$isRunning = false;
if ($startedAt !== null) {
    $startedTs = strtotime($startedAt) ?: 0;
    $endedTs   = $endedAt !== null ? (strtotime($endedAt) ?: 0) : 0;
    if ($endedAt === null || $startedTs > $endedTs) {
        $isRunning = true;
    }
}

if ($isRunning) {
    $result['status']      = 'RUNNING';
    $result['branch']      = $startedBranch;
    $result['commit']      = $startedCommit;
    $result['started_at']  = $startedAt;
    $result['age_seconds'] = max(0, $now - ((int)strtotime((string)$startedAt) ?: $now));
    $result['running']     = true;
    echo json_encode($result);
    return;
}

if ($endedAt === null) {
    $result['ok']    = false;
    $result['error'] = 'no completed deploy in log';
    echo json_encode($result);
    return;
}

$endedTs   = (int)strtotime($endedAt) ?: $now;
$startedTs = ($startedAt !== null && $startedCommit === $endedCommit)
    ? ((int)strtotime($startedAt) ?: $endedTs)
    : $endedTs;

// `ok` reflects deploy HEALTH, not just "log parsed": a FAILED deploy returns
// ok=false. Transport problems (404/500 above) also return ok=false but carry
// an `error` field — so a consumer tells them apart by: error present =
// endpoint problem; status=FAILED (no error) = the deploy itself failed.
$result['ok']               = ($endedStatus === 'OK');
$result['status']           = $endedStatus;
$result['branch']           = $endedBranch ?? $startedBranch;
$result['commit']           = $endedCommit;
$result['ended_at']         = $endedAt;
$result['duration_seconds'] = max(0, $endedTs - $startedTs);
$result['age_seconds']      = max(0, $now - $endedTs);
$result['running']          = false;

echo json_encode($result);
