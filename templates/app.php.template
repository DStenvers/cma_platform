<?php
/**
 * Application Configuration
 *
 * Only settings that differ from platform defaults need to be here.
 * Secrets and credentials go in .env files, not here.
 */

$GLOBALS['Application']['omgeving'] = $_ENV['APP_ENVIRONMENT'] ?? 'O';

// PATHS
$GLOBALS['Application']['base_path'] = '/';
$GLOBALS['Application']['path_images'] = $GLOBALS['Application']['base_path'] . 'images/';
$GLOBALS['Application']['pict_pixel'] = $GLOBALS['Application']['base_path'] . 'library/images/filler.gif';
$GLOBALS['Application']['cma_htmledit_img_path'] = $GLOBALS['Application']['path_images'] . 'html/';

// DATABASE
// Database connections are the single source of truth in databases.json:
// per-site data/databases.json (preferred), falling back to the platform
// default cma/config/databases.json. Name the entries 'data', 'rep' and
// 'users'. Use [db/file.mdb] for a path under the site root and [env:VAR] to
// pull a secret from .env. Do NOT define conn_data/conn_rep/conn_users here —
// the runtime no longer reads them (it builds connections from databases.json).

// EMAIL
$GLOBALS['Application']['email_from'] = 'info@example.com';
$GLOBALS['Application']['email_fromname'] = 'My Project';
// Afzender/CC voor bestelbevestiging + winkel-notificatie (views/afrekenen.inc gebruikt
// cc_email/email_cc). Niet leeg laten: een lege From geeft "Invalid address (From)".
$GLOBALS['Application']['cc_email'] = $GLOBALS['Application']['email_from'];
$GLOBALS['Application']['email_cc'] = $GLOBALS['Application']['email_from'];

// BRANDING
$GLOBALS['Application']['appname'] = 'My Project';
$GLOBALS['Application']['company'] = $GLOBALS['Application']['appname'];
$GLOBALS['Application']['name'] = $GLOBALS['Application']['company'];

// CMA
$GLOBALS['Application']['cma_language'] = 'NL';
$GLOBALS['Application']['mod_language'] = 'NL';

// MIGRATIES VAN DEZE SITE
// Het platform brengt zijn eigen databasemigraties mee (cma/config/migrations.json,
// versies 1.0.0 en hoger). Schemawijzigingen aan de tabellen van DEZE site horen in
// data/migrations/project_migrations.json, met de scripts ernaast - buiten de
// platform-gesyncte cma/-boom, dus een composer update raakt ze niet. Eigen
// versietabel, eigen versiereeks (0.x.x); een migratie heet "bron:versie", dus de
// twee reeksen raken elkaar nooit. De deploy draait ze via cma/migrate.php; met de
// hand via Beheer > Migraties. De Installer zet een leeg manifest neer.
$GLOBALS['Application']['migration_sources_extra'] = [
    [
        'name'          => 'site',
        'file'          => __DIR__ . '/data/migrations/project_migrations.json',
        'trackingDb'    => 'data',
        'trackingTable' => '_cma_site_version',
    ],
];

// RUNTIME
$GLOBALS['Application']['start'] = new DateTime();
$GLOBALS['Application']['local'] = ($GLOBALS['Application']['omgeving'] === 'O');
$GLOBALS['Application']['test'] = ($GLOBALS['Application']['omgeving'] !== 'P');

require_once __DIR__ . '/global.asa.php';
