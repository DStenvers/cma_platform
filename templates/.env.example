# Environment Configuration
# Copy this file to .env.local (development) or .env.production (production)

# Environment: L=Local, O=Development, T=Test, A=Acceptance, P=Production
APP_ENVIRONMENT=L

# Database paths (adjust to your project)
# DB_DATA_PATH=db/data.mdb
# DB_REP_PATH=db/repository.mdb
# DB_USERS_PATH=db/cmausers.sqlite

# Email settings
# SMTP_HOST=localhost
# SMTP_PORT=25

# Email logging (set to 1 to log all sent emails)
EMAIL_LOG_ENABLED=1

# CMA Debug mode (auto-enabled for O/L/T/A environments)
# CMA_DEBUG=0

# --- Deploy webhook (/deploy.php) --------------------------------------------
# The GitHub push-webhook deploys this site via the site-root /deploy.php.
# DEPLOY_SECRET enables deploys; the rest are optional (defaults shown).
# Easiest setup: Tools -> Developer -> Deploy setup, or check what is missing
# read-only via  https://<host>/deploy_status.php?config=1
# Full reference: Documentatie -> Deployment.
#
# DEPLOY_SECRET=                                    # REQUIRED — HMAC secret matching the GitHub webhook (openssl rand -hex 32)
# DEPLOY_BRANCH=main                                # branch this site deploys
# DEPLOY_PIPELINE=git pull --ff-only origin {branch}
# DEPLOY_COMPOSER_UPDATE=stenversonline/platform    # comma-separated packages; "-" to skip the composer step
# DEPLOY_RUN_TESTS=                                 # e.g. php cma/tests/TestRunner.php — non-zero exit blocks the deploy
# DEPLOY_RECYCLE_TOUCH=web.config                   # file to touch on success (IIS app-pool recycle); "-" to skip
# DEPLOY_POST_HOOK=deploy_post.php                  # project-side post-deploy script; "-" to skip
# DEPLOY_ALERT_EMAIL=                               # best-effort mail() on a FAILED deploy
# DEPLOY_LOG_FILE=logs/deploy.log
# DEPLOY_NO_RESET=0                                 # 1 = skip the pre-pull `git checkout -- .`
