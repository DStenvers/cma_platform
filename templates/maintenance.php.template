<?php
/**
 * Maintenance page — rendered by _bootstrap.php's maintenance gate while a
 * deploy swaps files.
 *
 * MUST stay dependency-free: NO Composer autoload, NO App\Library\* (that tree
 * is mid-swap during the deploy). Only native PHP + a defensive read of
 * data/app.json for branding. Any failure falls through to a generic message —
 * this page must never itself fatal.
 *
 * The gate already sent the 503 status + Content-Type headers; this file only
 * echoes the HTML body.
 *
 * Branding comes from data/app.json (never touched by composer/Installer):
 *   "maintenance": { "logo", "name", "message", "whatsapp", "email", "accent" }
 * each falling back to the "company" block, then to a sensible default. The
 * logo is referenced by URL — IIS serves static files directly, bypassing the
 * auto-prepend, so it still loads while the PHP app is down.
 */

// Branding sources, in priority order per field:
//   1. data/maintenance.json  — a dedicated, branding-only file. Safe for sites
//      that have no data/app.json: it never touches app.json's required
//      "company" block (ConfigLoader::load() REPLACES, not merges, so a partial
//      app.json would break the CMA logo).
//   2. data/app.json → "maintenance" block, then its "company" block.
// All reads are defensive and side-effect-free (native json_decode only).
$readJson = static function (string $path): array {
    if (is_file($path)) {
        $d = json_decode((string) @file_get_contents($path), true);
        if (is_array($d)) {
            return $d;
        }
    }
    return [];
};
$mj  = $readJson(__DIR__ . '/data/maintenance.json');
$app = $readJson(__DIR__ . '/data/app.json');
$m   = (isset($app['maintenance']) && is_array($app['maintenance'])) ? $app['maintenance'] : [];
$co  = (isset($app['company']) && is_array($app['company'])) ? $app['company'] : [];

// A manually-set flag (from the CMA maintenance tool) may carry a one-off
// custom message that overrides the configured one for this session.
$flagMsg = '';
$fc = trim((string) @file_get_contents(__DIR__ . '/maintenance.flag'));
if ($fc !== '') {
    $fj = json_decode($fc, true);
    if (is_array($fj) && isset($fj['message']) && is_string($fj['message'])) {
        $flagMsg = trim($fj['message']);
    }
}

$pick = static function (...$vals): string {
    foreach ($vals as $v) {
        if (is_string($v) && trim($v) !== '') {
            return trim($v);
        }
    }
    return '';
};
$h = static fn($s): string => htmlspecialchars((string) $s, ENT_QUOTES, 'UTF-8');

$name    = $pick($mj['name'] ?? '', $m['name'] ?? '', $co['name'] ?? '', $_SERVER['HTTP_HOST'] ?? '');
$message = $pick($flagMsg, $mj['message'] ?? '', $m['message'] ?? '', 'We zijn even bezig met de website, duurt niet lang.');
$accent  = $pick($mj['accent'] ?? '', $m['accent'] ?? '', $co['backgroundColor'] ?? '', '#b8892b');
$logo    = $pick($mj['logo'] ?? '', $m['logo'] ?? '', $co['logo'] ?? '');
$whats   = preg_replace('/\D+/', '', (string) ($mj['whatsapp'] ?? $m['whatsapp'] ?? ''));
$email   = $pick($mj['email'] ?? '', $m['email'] ?? '');

// Resolve a relative logo path against the web root; leave absolute/URL as-is.
$logoUrl = ($logo !== '' && !preg_match('#^(https?:)?/#', $logo)) ? '/' . ltrim($logo, '/') : $logo;

// Build the "still stuck?" contact line from whatever the site configured.
$contact = [];
if ($whats !== '') {
    $disp = (strpos($whats, '31') === 0) ? '0' . substr($whats, 2) : $whats;
    $disp = preg_replace('/^(\d{2})(\d+)$/', '$1 $2', $disp); // 06 54752275
    $contact[] = 'App me even op <a href="https://wa.me/' . $h($whats) . '">' . $h($disp) . '</a>';
}
if ($email !== '') {
    $contact[] = ($contact ? 'of mail ' : 'Mail ') . '<a href="mailto:' . $h($email) . '">' . $h($email) . '</a>';
}
$contactLine = $contact ? implode(' ', $contact) . '.' : '';
?>
<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Even geduld<?= $name !== '' ? ' — ' . $h($name) : '' ?></title>
<style>
  :root { color-scheme: light; }
  html { height: 100%; }
  body {
    margin: 0; min-height: 100%;
    display: flex; align-items: center; justify-content: center; padding: 1.5rem;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    background: #faf8f5; color: #2b2622;
  }
  .box { max-width: 30rem; text-align: center; }
  .logo { max-width: 240px; max-height: 72px; width: auto; height: auto; margin: 0 0 1.75rem; }
  .brand {
    font-size: .8rem; letter-spacing: .2em; text-transform: uppercase;
    color: #9a8f80; margin-bottom: 1.5rem;
  }
  h1 { font-size: 1.55rem; font-weight: 600; margin: 0 0 .6rem; line-height: 1.3; }
  p { margin: .5rem 0; line-height: 1.6; color: #5c5449; }
  .help { margin-top: 1.75rem; font-size: .95rem; }
  a { color: <?= $h($accent) ?>; font-weight: 600; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .dot {
    display: inline-block; width: .55rem; height: .55rem; border-radius: 50%;
    background: <?= $h($accent) ?>; margin-right: .5rem; vertical-align: middle;
    animation: pulse 1.4s ease-in-out infinite alternate;
  }
  @keyframes pulse { to { opacity: .35; } }
</style>
</head>
<body>
  <div class="box">
    <?php if ($logoUrl !== ''): ?>
      <img class="logo" src="<?= $h($logoUrl) ?>" alt="<?= $h($name) ?>">
    <?php elseif ($name !== ''): ?>
      <div class="brand"><?= $h($name) ?></div>
    <?php endif; ?>
    <h1><span class="dot"></span><?= $h($message) ?></h1>
    <p>Probeer het over een paar minuten opnieuw.</p>
    <?php if ($contactLine !== ''): ?>
      <p class="help">Blijft u deze melding langer dan 10 minuten zien?<br><?= $contactLine ?></p>
    <?php endif; ?>
  </div>
</body>
</html>
