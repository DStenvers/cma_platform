<?php
/**
 * Bootstrap - Auto-prepended to all requests via IIS URL Rewrite
 *
 * This is a thin wrapper that calls the platform Bootstrap class.
 * Project-specific configuration is passed via the $config array.
 */

// Bootstrap timing
$GLOBALS['_bootstrap_start'] = microtime(true);

// Prevent direct access
if (basename($_SERVER['PHP_SELF']) === '_bootstrap.php') {
    http_response_code(403);
    die('Direct access not permitted');
}

// ── Maintenance mode ─────────────────────────────────────────────────────
// deploy.php raises maintenance.flag around `composer update`, while vendor/
// and the platform files are mid-swap and a normal request would hit
// half-updated code and fatal. Answer HERE — before the Composer autoloader,
// using only native PHP — with a clean 503 so visitors see a "back shortly"
// page instead of a stack of errors. Keep this block dependency-free.
(static function (): void {
    $flag = __DIR__ . '/maintenance.flag';
    if (!is_file($flag)) {
        return;
    }
    $raw  = trim((string) @file_get_contents($flag));
    $data = ($raw !== '') ? json_decode($raw, true) : [];
    if (!is_array($data)) {
        $data = [];
    }
    // A manual toggle (set from the CMA) carries "manual":true and stays until
    // an admin lifts it. A deploy flag has no marker and auto-lifts after 20 min
    // as a crashed/killed-deploy safety net.
    $manual = !empty($data['manual']);
    if (!$manual && time() - (int) @filemtime($flag) > 1200) {
        @unlink($flag);
        return;
    }
    // deploy.php / deploy_status.php + the admin app (/cma/) must stay reachable
    // during maintenance. Match on REQUEST_URI, NOT SCRIPT_NAME: with the
    // _bootstrap_wrapper.php auto-prepend SCRIPT_NAME is the wrapper, so a
    // SCRIPT_NAME check gated deploy.php itself and wedged the site behind its
    // own maintenance flag (it could never clear it).
    $uri = (string) ($_SERVER['REQUEST_URI'] ?? '');
    if (strpos($uri, '/cma/') === 0
        || preg_match('#(^|/)(deploy|deploy_status)\\.php(\\?|$)#', $uri)) {
        return;
    }
    http_response_code(503);
    header('Retry-After: 120');
    header('Content-Type: text/html; charset=UTF-8');
    header('Cache-Control: no-store, must-revalidate');
    // The maintenance page takes ONE variable: the admin's custom text (empty
    // during a deploy → the page falls back to its default message).
    $message = is_string($data['message'] ?? null) ? $data['message'] : '';
    $page = __DIR__ . '/src/pages/maintenance.php';
    if (is_file($page)) {
        include $page; // dependency-free; renders $message
    } else {
        $m = ($message !== '') ? $message : 'We zijn even bezig met de website, duurt niet lang.';
        echo "<!doctype html><html lang=\"nl\"><head><meta charset=\"utf-8\">"
           . "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
           . "<title>Even geduld</title><style>"
           . "html{height:100%}body{margin:0;min-height:100%;display:flex;align-items:center;justify-content:center;"
           . "font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#faf8f5;color:#2b2622}"
           . ".box{max-width:30rem;padding:2.5rem;text-align:center}h1{font-size:1.55rem;margin:0 0 .75rem}"
           . "p{margin:.4rem 0;line-height:1.5;color:#5c5449}.dot{display:inline-block;width:.55rem;height:.55rem;"
           . "border-radius:50%;background:#b8892b;margin-right:.5rem;animation:p 1.4s infinite alternate}"
           . "@keyframes p{to{opacity:.35}}</style></head><body><div class=\"box\">"
           . "<h1><span class=\"dot\"></span>" . htmlspecialchars($m, ENT_QUOTES, 'UTF-8') . "</h1>"
           . "<p>Probeer het over een paar minuten opnieuw.</p></div></body></html>";
    }
    exit;
})();

// Load Composer autoloader (includes platform helpers)
require_once __DIR__ . '/vendor/autoload.php';

// Initialize the application with project-specific configuration
\App\Library\Bootstrap::init(__DIR__, [
    'app_config'     => __DIR__ . '/app.php',
    'global_asa'     => __DIR__ . '/global.asa.php',
    'session_dir'    => __DIR__ . '/.sessions',
    'constants_file' => __DIR__ . '/_bootstrap_constants.inc',
    'log_dir'        => __DIR__ . '/logs',
    'db_dir'         => __DIR__ . '/db',
]);
