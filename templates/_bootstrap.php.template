<?php
/**
 * Bootstrap - Auto-prepended to all requests via IIS URL Rewrite
 *
 * This is a thin wrapper that calls the platform Bootstrap class.
 * Project-specific configuration is passed via the $config array.
 */

// Bootstrap timing
$GLOBALS['_bootstrap_start'] = microtime(true);

// Prevent direct access
if (basename($_SERVER['PHP_SELF']) === '_bootstrap.php') {
    http_response_code(403);
    die('Direct access not permitted');
}

// ── Maintenance mode ─────────────────────────────────────────────────────
// deploy.php raises maintenance.flag around `composer update`, while vendor/
// and the platform files are mid-swap and a normal request would hit
// half-updated code and fatal. Answer HERE — before the Composer autoloader,
// using only native PHP — with a clean 503 so visitors see a "back shortly"
// page instead of a stack of errors. Keep this block dependency-free.
(static function (): void {
    $flag = __DIR__ . '/maintenance.flag';
    if (!is_file($flag)) {
        return;
    }
    // Stuck-deploy safety: a flag older than 20 min means a crashed/killed
    // deploy never cleared it — lift it rather than wall the site off forever.
    if (time() - (int) @filemtime($flag) > 1200) {
        @unlink($flag);
        return;
    }
    // The deploy hatch + its status poller must stay reachable during a deploy.
    $self = basename((string) ($_SERVER['SCRIPT_NAME'] ?? $_SERVER['PHP_SELF'] ?? ''));
    if (in_array($self, ['deploy.php', 'deploy_status.php'], true)) {
        return;
    }
    http_response_code(503);
    header('Retry-After: 120');
    header('Content-Type: text/html; charset=UTF-8');
    header('Cache-Control: no-store, must-revalidate');
    $page = __DIR__ . '/maintenance.php';
    if (is_file($page)) {
        include $page; // dependency-free; reads data/app.json for branding
    } else {
        echo "<!doctype html><html lang=\"nl\"><head><meta charset=\"utf-8\">"
           . "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
           . "<title>Even geduld</title><style>"
           . "html{height:100%}body{margin:0;min-height:100%;display:flex;align-items:center;justify-content:center;"
           . "font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#f5f5f4;color:#292524}"
           . ".box{max-width:30rem;padding:2.5rem;text-align:center}h1{font-size:1.5rem;margin:0 0 .75rem}"
           . "p{margin:.4rem 0;line-height:1.5;color:#57534e}.dot{display:inline-block;width:.5rem;height:.5rem;"
           . "border-radius:50%;background:#f59e0b;margin-right:.4rem;animation:p 1s infinite alternate}"
           . "@keyframes p{to{opacity:.3}}</style></head><body><div class=\"box\">"
           . "<h1><span class=\"dot\"></span>Even onderhoud</h1>"
           . "<p>We voeren een korte update uit. De site is zo weer bereikbaar.</p>"
           . "<p>Probeer het over een minuutje opnieuw.</p></div></body></html>";
    }
    exit;
})();

// Load Composer autoloader (includes platform helpers)
require_once __DIR__ . '/vendor/autoload.php';

// Initialize the application with project-specific configuration
\App\Library\Bootstrap::init(__DIR__, [
    'app_config'     => __DIR__ . '/app.php',
    'global_asa'     => __DIR__ . '/global.asa.php',
    'session_dir'    => __DIR__ . '/sessions',
    'constants_file' => __DIR__ . '/_bootstrap_constants.inc',
    'log_dir'        => __DIR__ . '/logs',
    'db_dir'         => __DIR__ . '/db',
]);
