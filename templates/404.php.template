<?php
/**
 * Site 404 handler.
 *
 * Two callers reach this file, and both expect it at the site root:
 *   - IIS, via web.config: <error statusCode="404" path="/404.php" responseMode="ExecuteURL"/>
 *     (missing static files and unknown URLs);
 *   - _bootstrap_wrapper.php, when the rewritten path resolves to no file.
 *
 * It logs the miss to .logs/404/ so misses show up in the CMA log reader, then
 * lets the platform render the page (cma/notfound_page.inc) — the same one the
 * CMA itself uses, so a change to it lands here with a composer update.
 *
 * Deliberately lightweight: no bootstrap, no Composer autoload. This also fires
 * for missing static files, where bootstrapping would only add failure modes
 * (and sessions would override cache headers). Raw $_SERVER only.
 *
 * This file is yours to edit — the Installer only creates it when it is absent
 * and never overwrites it afterwards. Site-specific behaviour (vanity-URL
 * redirects, a different log destination, other copy) belongs here; the look of
 * the page belongs in the platform.
 */

$requestUri    = $_SERVER['REQUEST_URI'] ?? '/unknown';
$requestedPath = parse_url($requestUri, PHP_URL_PATH) ?: $requestUri;

// ---- Log the miss --------------------------------------------------------------
$logDir = __DIR__ . '/.logs/404';
if (!is_dir($logDir)) {
    @mkdir($logDir, 0755, true);
}
@file_put_contents(
    $logDir . '/404_' . date('Y-m-d') . '.log',
    json_encode([
        'ts'      => date('Y-m-d\TH:i:s'),
        'url'     => $requestUri,
        'referer' => $_SERVER['HTTP_REFERER'] ?? '',
        'method'  => $_SERVER['REQUEST_METHOD'] ?? 'GET',
        'ip'      => $_SERVER['REMOTE_ADDR'] ?? '',
        'ua'      => substr($_SERVER['HTTP_USER_AGENT'] ?? '', 0, 200),
        'type'    => 'not_found',
    ], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n",
    FILE_APPEND | LOCK_EX
);

if (!headers_sent()) {
    http_response_code(404);
}

// API/ajax callers get JSON — an HTML page in a fetch() response reads as a
// parse error and hides the fact that the URL was simply wrong.
if (strpos($requestUri, '/api/') !== false
    || stripos($requestUri, 'ajax') !== false
    || strpos($_SERVER['HTTP_ACCEPT'] ?? '', 'application/json') !== false) {
    if (!headers_sent()) {
        header('Content-Type: application/json; charset=utf-8');
    }
    echo json_encode([
        'error'   => 'Not Found',
        'message' => 'De opgevraagde pagina bestaat niet.',
        'path'    => $requestedPath,
    ], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    exit;
}

if (!headers_sent()) {
    header('Content-Type: text/html; charset=utf-8');
}

// The page comes from the platform; it classifies file-versus-page on the
// extension itself. The guard keeps this working before the first sync of cma/.
$platformPage = __DIR__ . '/cma/notfound_page.inc';
if (is_file($platformPage)) {
    require $platformPage;
    exit;
}

echo '<!doctype html><html lang="nl"><head><meta charset="utf-8">'
   . '<meta name="viewport" content="width=device-width,initial-scale=1">'
   . '<meta name="robots" content="noindex">'
   . '<title>Pagina niet gevonden</title></head><body>'
   . '<h1>Pagina niet gevonden</h1><p>' . htmlspecialchars($requestedPath, ENT_QUOTES, 'UTF-8') . '</p>'
   . '<p><a href="/">Terug naar start</a></p></body></html>';
