<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Enable gzip compression for static and dynamic content -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />

        <!-- URL Rewrite to bootstrap all PHP files -->
        <!-- Note: allowedServerVariables (HTTP_X_ORIGINAL_FILE, HTTP_X_TOOL_NAME) are configured at IIS server level -->
        <rewrite>
            <rules>
                <!-- Friendly URLs for CMA tools: /cma/tools/[name].
                     Hoort BOVEN de "Skip /cma"-regel hieronder: die matcht ook
                     op /cma/tools/... en stopt de keten, dus daaronder wordt
                     deze rule nooit bereikt. De Installer schuift het CMA-blok
                     bovenaan <rules>; deze rule sluit daar direct op aan. -->
                <rule name="CMA Tools Friendly URL" stopProcessing="true">
                    <match url="^cma/tools/([a-z0-9_-]+)$" ignoreCase="true" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <serverVariables>
                        <set name="HTTP_X_ORIGINAL_FILE" value="/cma/tools.php" />
                        <set name="HTTP_X_TOOL_NAME" value="{R:1}" />
                    </serverVariables>
                    <action type="Rewrite" url="/_bootstrap_wrapper.php" appendQueryString="true" />
                </rule>

                <!-- IMPORTANT: leave everything under /cma alone, so the parent's
                     own routers (typical pattern: catch-all `_bootstrap_wrapper.php`)
                     don't hijack CMA assets, *.php and api/ requests.
                     action=None + stopProcessing=true means "leave this URL
                     untouched and stop here".

                     ORDER MATTERS. stopProcessing halts the ENTIRE chain — the
                     rules in cma/web.config included. The CMA friendly-URL rules
                     (CMA Dashboard, CMA Form …, injected at the top of <rules> by
                     the Installer) must therefore come BEFORE this rule; move it
                     up and every clean CMA URL 404s while /cma/dashboard.php keeps
                     working. If you add HTTPS / www-subdomain redirects, place
                     those before this rule so /cma/* still gets force-redirected. -->
                <rule name="Skip /cma to child config" stopProcessing="true">
                    <match url="^cma($|/)" />
                    <action type="None" />
                </rule>

                <!-- Handle directory requests (e.g., /cma/) - check for default.php -->
                <rule name="Bootstrap Directory Default" stopProcessing="true">
                    <match url="^(.*?)/?$" ignoreCase="true" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
                        <add input="{REQUEST_FILENAME}/default.php" matchType="IsFile" />
                    </conditions>
                    <serverVariables>
                        <set name="HTTP_X_ORIGINAL_FILE" value="/{R:1}/default.php" />
                    </serverVariables>
                    <action type="Rewrite" url="/_bootstrap_wrapper.php" appendQueryString="true" />
                </rule>

                <!-- Handle directory requests - check for index.php -->
                <rule name="Bootstrap Directory Index" stopProcessing="true">
                    <match url="^(.*?)/?$" ignoreCase="true" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
                        <add input="{REQUEST_FILENAME}/index.php" matchType="IsFile" />
                    </conditions>
                    <serverVariables>
                        <set name="HTTP_X_ORIGINAL_FILE" value="/{R:1}/index.php" />
                    </serverVariables>
                    <action type="Rewrite" url="/_bootstrap_wrapper.php" appendQueryString="true" />
                </rule>

                <!-- Skip bootstrap for minify.php - it handles its own caching and doesn't need sessions -->
                <rule name="Skip Bootstrap for Minify" stopProcessing="true">
                    <match url="^cma/minify\.php$" ignoreCase="true" />
                    <action type="None" />
                </rule>

                <rule name="Bootstrap PHP Files" stopProcessing="true">
                    <match url="^(.*)\.php$" ignoreCase="true" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" />
                        <add input="{REQUEST_URI}" pattern="_bootstrap\.php$" negate="true" />
                        <add input="{REQUEST_URI}" pattern="_bootstrap_wrapper\.php$" negate="true" />
                    </conditions>
                    <serverVariables>
                        <set name="HTTP_X_ORIGINAL_FILE" value="{URL}" />
                    </serverVariables>
                    <action type="Rewrite" url="/_bootstrap_wrapper.php" appendQueryString="true" />
                </rule>

                <!-- Redirect .asp requests to .php -->
                <rule name="ASP redirect" stopProcessing="true">
                    <match url="^(.*)\.asp$" ignoreCase="true" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <serverVariables>
                        <set name="HTTP_X_ORIGINAL_FILE" value="{R:1}.php" />
                    </serverVariables>
                    <action type="Rewrite" url="/_bootstrap_wrapper.php" appendQueryString="true" />
                </rule>

            </rules>

            <!-- Belt + suspenders: if PHP forgets to set Content-Type (e.g.
                 a fatal error before the handler set a header, or an
                 empty default_mimetype), the response goes out without a
                 Content-Type. Combined with X-Content-Type-Options:nosniff
                 below, mobile browsers — especially the installed PWA on
                 iOS Safari — refuse to sniff and offer the page as a
                 *download* (the classic "Download logreader.php?" prompt).
                 This outbound rule fires only when Content-Type is empty
                 and rewrites it to text/html. PHP-set Content-Types are
                 left untouched. See the Security doc topic for the full
                 explanation. -->
            <outboundRules>
                <rule name="Default Content-Type to text/html" preCondition="ContentTypeMissing">
                    <match serverVariable="RESPONSE_Content-Type" pattern=".*" />
                    <action type="Rewrite" value="text/html; charset=UTF-8" />
                </rule>
                <preConditions>
                    <preCondition name="ContentTypeMissing">
                        <add input="{RESPONSE_Content-Type}" pattern="^$" />
                    </preCondition>
                </preConditions>
            </outboundRules>
        </rewrite>

        <!-- Default document settings -->
        <defaultDocument>
            <files>
                <clear />
                <add value="default.php" />
                <add value="index.php" />
            </files>
        </defaultDocument>

        <!-- Security headers -->
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
            </customHeaders>
        </httpProtocol>

        <!-- Hide sensitive files and remove Server header -->
        <security>
            <requestFiltering removeServerHeader="true">
                <hiddenSegments>
                    <add segment=".env" />
                    <add segment=".app_started" />
                    <add segment=".sessions" />
                    <add segment="composer.json" />
                    <add segment="composer.lock" />
                </hiddenSegments>
            </requestFiltering>
        </security>

        <!-- PHP Settings  , removed because it is too sensitive for configuration errors due to the hard-coded path to php-cgi.exe - recommend configuring at IIS server level instead 
        <handlers>
            <add name="localphp" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="C:\Program Files\php\php-cgi.exe" resourceType="File" />
            <add name="PHP_via_FastCGI" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="C:\PHP\php-cgi.exe" resourceType="Either" />
        </handlers>

          PHP FastCGI Configuration 
        <fastCgi>
            <application fullPath="C:\PHP\php-cgi.exe">
                <environmentVariables>
                    <environmentVariable name="PHP_FCGI_MAX_REQUESTS" value="10000" />
                </environmentVariables>
            </application>
        </fastCgi>
        -->
        <!-- Static content caching - 1 year for versioned assets (use ?v= for cache busting) -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
            <!-- Ensure JSON mime type is set (remove first to avoid duplicate error) -->
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            <!-- WebP image support (remove first to avoid duplicate error) -->
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <!-- Web fonts. IIS answers 404 for an extension it does not know, so
                 without these the icon font never arrives and every glyph-based
                 icon on the site renders as nothing — which looks like a styling
                 bug rather than a missing file. -->
            <remove fileExtension=".woff" />
            <mimeMap fileExtension=".woff" mimeType="font/woff" />
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <remove fileExtension=".ttf" />
            <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
        </staticContent>

        <!-- Custom 404 page routed to /404.php (created by the Installer when the
             site does not have one). existingResponse="Auto" prevents the redirect
             loop that occurs when 404.php itself answers with a 404 status. -->
        <httpErrors existingResponse="Auto" errorMode="Custom">
            <remove statusCode="404" subStatusCode="-1" />
            <error statusCode="404" path="/404.php" responseMode="ExecuteURL" />
        </httpErrors>
    </system.webServer>

    <!-- Cache fonts for 1 year (fonts rarely change) -->
    <location path="library/fonts">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>

    <!-- Cache favicon for 1 year -->
    <location path="favicon.ico">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>
</configuration>
